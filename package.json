{
  "name": "chest-teleporter",
  "version": "0.0.1",
  "description": "Transfer all the chest from one base to another using bots in Minecraft",
  "keywords": [
    "mineflayer",
    "2b2t"
  ],
  "homepage": "https://github.com/adriabama06/chest-teleporter#readme",
  "bugs": {
    "url": "https://github.com/adriabama06/chest-teleporter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adriabama06/chest-teleporter.git"
  },
  "license": "MIT",
  "author": "adriabama06",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start:teleporter": "node --env-file=.env src/teleporter.js",
    "start:storagemanager1": "node --env-file=.env src/storagemanager.js 1",
    "start:storagemanager2": "node --env-file=.env src/storagemanager.js 2",
    "cache": "node --env-file=.env src/cachebot.js",
    "test": "node --test"
  },
  "dependencies": {
    "minecraft-data": "^3.114.0",
    "mineflayer": "^4.38.0",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-block": "^1.23.0",
    "prismarine-entity": "^2.6.0",
    "prismarine-item": "^1.18.0",
    "prismarine-nbt": "^2.8.0",
    "vec3": "^0.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
